{
  "folders": [{"path": "."}],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests", "-m", "not slow and not octave"],
    "editor.formatOnSave": true,
    "[python]": {"editor.defaultFormatter": "charliermarsh.ruff"},
    "files.exclude": {"**/__pycache__": true, "**/.pytest_cache": true},
    "search.exclude": {".venv": true, "results": true, "paper/*.pdf": true}
  },
  "extensions": {"recommendations": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "ms-toolsai.jupyter"]}
}
